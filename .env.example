# Copy to .env and fill in. Used by docker-compose.yml (env_file).
#
# DISCORD_WEBHOOK_URL/DISCORD_POST_ARTICLE_TEXT are deliberately NOT here --
# the webapp takes those as per-request form inputs instead of container
# secrets. This file is only for the two image-generation API keys.

# Headliner illustration (gemini-2.5-flash-image), from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Newspaper front page (gpt-image-2), from https://platform.openai.com/api-keys
OPENAI_API_KEY=
